# ==============================================================================
# FRAME / MOTION — CINEMATIC VIDEO PRODUCTION & FILM STUDIO
# ENVIRONMENT CONFIGURATION (.env.local)
# ==============================================================================

# 1. Supabase PostgreSQL & Auth Credentials
# (Get these from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. JWT Session Secret for Admin Authentication (32+ chars)
ADMIN_JWT_SECRET=cinematic-frame-motion-studio-ultra-secure-secret-key-2025

# 3. Default Initial Admin Credentials
# (Used to bootstrap the local / database admin if not already registered)
INITIAL_ADMIN_EMAIL=admin@framemotion.com
INITIAL_ADMIN_PASSWORD=cinematic2025!

# 4. Optional Storage Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
